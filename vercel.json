{
  "routes": [
    { "src": "/class/site/lessons/(.*)", "dest": "class/site/lessons/$1" },
    { "src": "/class/lessons/(.*)", "dest": "class/lessons/$1" },
    { "src": "/lessons/(.*)", "dest": "class/lessons/$1" },
    { "src": "/tutor.js", "dest": "class/site/tutor.js" },
    { "src": "/tutor.css", "dest": "class/site/tutor.css" },
    { "src": "/d1.json", "dest": "class/lessons/d1.json" },
    { "src": "/index.html", "dest": "class/site/index.html" },
    { "src": "/lesson-d1.html", "dest": "class/site/lesson-d1.html" },
    { "src": "/(.*)", "dest": "class/site/$1" }
  ]
}
